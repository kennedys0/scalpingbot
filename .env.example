# ============================================================
# Telegram Configuration
# ============================================================
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Comma-separated list of Telegram User IDs authorized to interact with the bot
TELEGRAM_ALLOWED_USER_IDS="123456789"

# ============================================================
# AI Configuration (OpenRouter / OpenAI-Compatible)
# ============================================================
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# API Key dedicated for Base chain scalping decisions
OPENROUTER_API_KEY_BASE="sk-or-v1-base-key-..."
# API Key dedicated for Robinhood chain scalping decisions
OPENROUTER_API_KEY_ROBINHOOD="sk-or-v1-rh-key-..."
# Customizable AI models per chain
AI_MODEL_BASE="deepseek/deepseek-chat"
AI_MODEL_ROBINHOOD="anthropic/claude-3.5-sonnet"

# ============================================================
# EVM Wallets & RPC Providers
# ============================================================
# Private key for executing live swaps (0x...) - leave blank or dummy in paper mode
WALLET_PRIVATE_KEY=""

# Base Network (Chain ID: 8453)
BASE_RPC_URL="https://mainnet.base.org"
BASE_RPC_FALLBACK="https://base.llamarpc.com"

# Robinhood Chain (Chain ID: 4663 - Arbitrum Orbit Stack)
ROBINHOOD_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
ROBINHOOD_RPC_FALLBACK="https://robinhood-rpc.publicnode.com"

# ============================================================
# Risk Management & Strategy Settings
# ============================================================
# Default trading mode: "paper" (simulation) or "live" (on-chain)
DEFAULT_TRADING_MODE="paper"

# Hard maximum loss allowed on any single trade (percentage)
MAX_LOSS_PER_TRADE_PCT=7.0

# Circuit breaker: maximum total realized daily loss in ETH before all buying halts
MAX_DAILY_LOSS_ETH=0.10

# Default trade allocation per scalp in ETH
DEFAULT_TRADE_SIZE_ETH=0.02

# Maximum concurrent open positions per chain
MAX_CONCURRENT_POSITIONS=3

# Default slippage percentage for standard swaps (e.g. 1.0 = 1%)
DEFAULT_SLIPPAGE_PCT=1.5

# Slippage tolerance for new pool snipes (e.g. 15.0 = 15%)
SNIPER_SLIPPAGE_PCT=15.0

# Minimum pool liquidity in USD required before considering a token
MIN_LIQUIDITY_USD=5000

# Minimum confidence score (0-100) required from AI before entering trade
MIN_AI_CONFIDENCE=75

# ============================================================
# New Token Auto-Sniper Configuration
# ============================================================
# Master switch for auto-sniping newly deployed pools (true / false)
AUTO_SNIPER_ENABLED=false

# Position size per auto-snipe trade in ETH
SNIPER_TRADE_SIZE_ETH=0.01

# Minimum initial pool liquidity in USD required before considering a snipe
SNIPER_MIN_LIQUIDITY_USD=2000

# Maximum token age in minutes (e.g. 30 = only tokens launched <= 30 mins ago)
SNIPER_MAX_AGE_MINUTES=30

# Minimum Token Security Score (0-100) required before buying
SNIPER_MIN_SECURITY_SCORE=80

# Stage 1: Fast AI Pre-Snipe Veto (true / false)
SNIPER_AI_PRE_VETO=true

# Stage 2: AI Post-Snipe Active Order Flow Sentinel (true / false)
SNIPER_AI_ACTIVE_MONITOR=true

